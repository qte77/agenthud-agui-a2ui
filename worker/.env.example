# Cloudflare deploy-time auth for `wrangler deploy` (NON-interactive / CI).
#
# You do NOT need this if you've run `wrangler login` (interactive OAuth) — it's the
# token-based alternative for CI or reproducible deploys. Copy to `worker/.env`
# (gitignored), fill in real values, then export before deploying:
#
#   set -a; source worker/.env; set +a
#   npx wrangler deploy
#
# The WORKER ITSELF HOLDS NO SECRET (BYOK pass-through) — these are only for *deploying*.

# API token with the "Edit Cloudflare Workers" template
# (create at https://dash.cloudflare.com/profile/api-tokens).
CLOUDFLARE_API_TOKEN=

# Account id (dash -> Workers & Pages -> Account ID). Needed when your token
# can reach more than one account.
CLOUDFLARE_ACCOUNT_ID=
