    "eslint": "^10.15.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.165.0"
