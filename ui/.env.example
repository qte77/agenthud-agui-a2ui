# DEV-ONLY local config. Copy to ui/.env (gitignored) to skip retyping in the UI on `npm run dev`.
#
# ⚠️  SECURITY: Vite inlines VITE_* into the CLIENT bundle. These are read ONLY behind
# `import.meta.env.DEV` (tree-shaken out of production builds) and `ui/.env` is gitignored — NEVER
# put real keys in a build you intend to deploy (they would ship in the public JS).

# --- BYOK connection prefill (your own key) ---
# CORS-friendly providers work DIRECT from the browser, no worker needed:
#   OpenRouter  https://openrouter.ai/api/v1     key: https://openrouter.ai/keys
#   Groq        https://api.groq.com/openai/v1   key: https://console.groq.com/keys
#   (also Together https://api.together.ai/v1, Fireworks, DeepSeek — each with its own key)
VITE_BYOK_BASE_URL="https://openrouter.ai/api/v1"
VITE_BYOK_API_KEY=""
VITE_BYOK_MODEL="openai/gpt-5.4-mini"

# --- Non-CORS providers (GitHub Models, Google) — need the edge proxy ---
# They send no browser CORS, so they route through worker/. The PRODUCTION worker rejects localhost
# by design, so for local dev run a localhost-allowed worker and point VITE_PROXY_BASE at it:
#   cd worker && printf 'ALLOW_LOCALHOST="true"\n' >> .dev.vars && npx wrangler dev   # http://localhost:8787
# then pick "GitHub Models (via proxy)" / "Google (via proxy)" in the UI with your own token:
#   GitHub Models — a GitHub PAT with the `models: read` permission (github.com/settings/tokens).
#                   Models use a provider prefix, e.g. openai/gpt-4.1, openai/gpt-4o-mini.
#                   NOTE: GitHub Models is fully retired 2026-07-30 — this provider will stop working.
#   Google Gemini — an API key from aistudio.google.com. Models e.g. gemini-3.5-flash.
VITE_PROXY_BASE="http://localhost:8787"
