{
  // Mirrors the shared qte77 markdownlint config (qte77/.github), which the
  // `lint-md-links` reusable workflow downloads as `.markdownlint.jsonc` when a
  // repo lacks one. Committed here so local linting matches CI exactly.
  //
  // Filename MUST be `.markdownlint.jsonc` (or `.markdownlint.json`): the reusable
  // workflow's `markdownlint-cli2-action` only checks for those names. Rules live
  // at the top level (markdownlint config shape), not under a `config` key.
  "MD013": false, // line-length: long lines allowed (URL-rich tables/badges)
  "MD033": false, // inline HTML: allowed (img/details/summary/br)
  "MD024": { "siblings_only": true }, // duplicate headings OK if not siblings
  "MD041": false, // first line need not be a top-level heading
  "MD060": false // table pipe alignment not required (long URL cells)
}
